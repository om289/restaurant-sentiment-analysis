# Mumbai Restaurant Analytics Dashboard - Environment Variables

# ==============================================================================
# GEMINI AI API KEY (Required for AI-powered features)
# ==============================================================================
# Obtain your free API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# This key enables:
# - Gemini AI Copilot tab (natural language insights)
# - XAI explanations (SHAP/LIME token attribution)
# - Dynamic review extraction and sentiment reasoning
#
# The app will function without this key, but AI features will be disabled.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# OPTIONAL: Base Path for Deployment
# ==============================================================================
# Uncomment and set if deploying to a subdirectory (e.g., GitHub Pages)
# Example: /my-repo-name/
# VITE_BASE_PATH=/
